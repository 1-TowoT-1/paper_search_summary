APP_NAME=LitSage
APP_VERSION=0.1.0
ENVIRONMENT=dev
AUTO_CREATE_TABLES=true

DATABASE_URL=postgresql+psycopg://litsage:litsage@localhost:5432/litsage
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MILVUS_URI=http://localhost:19530
ABSTRACT_COLLECTION=paper_abstracts
CHUNK_COLLECTION=paper_chunks
EMBEDDING_DIM=1024

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_OLLAMA_MODEL=qwen2.5:7b

SEARCH_CACHE_TTL_SECONDS=600
PAPER_SUMMARY_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=20
